<Window x:Class="Proxmark3GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Proxmark3GUI.Views"
        Title="Proxmark3 GUI Client" Height="900" Width="1400"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDark}">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding QuickScanCommand}"/>
        <KeyBinding Key="F6" Command="{Binding QuickAutoPwnCommand}"/>
        <KeyBinding Key="F7" Command="{Binding QuickDumpCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="200" MaxWidth="280"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380" MinWidth="300" MaxWidth="500"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource BgMedium}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="12,8" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="PM3" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentSecondary}"/>
                        <TextBlock Text="Client" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="4,8">
                    <ItemsControl ItemsSource="{Binding NavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="NavBorder" Padding="10,8" Margin="2,1" CornerRadius="6"
                                        Background="Transparent" Cursor="Hand" MouseLeftButtonUp="NavBorder_MouseLeftButtonUp">
                                    <StackPanel Orientation="Horizontal" Margin="2,0">
                                        <TextBlock Text="{Binding Icon}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Label}" FontSize="12.5" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="NavBorder" Property="Background" Value="{StaticResource BgHover}"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="NavBorder" Property="Background" Value="{StaticResource BgActive}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2" Padding="10,8" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource AccentRed}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource AccentGreen}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Grid.Column="1" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Disconnected"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Text" Value="Connected"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="3" Background="{StaticResource BorderDark}" HorizontalAlignment="Center"/>

        <Border Grid.Column="2" Background="{StaticResource BgDark}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="24,16" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentPanelTitle}" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Text="{Binding CurrentPanelSubtitle}" Style="{StaticResource PanelSubtitle}"/>
                    </StackPanel>
                </Border>

                <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
            </Grid>
        </Border>

        <Border Grid.Column="3" Background="{StaticResource BgMedium}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="12,10" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PM3 Console Output" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Clear" Style="{StaticResource FlatButton}" Padding="8,4" FontSize="11"
                                    Command="{Binding ClearConsoleCommand}"/>
                            <Button Content="Save" Style="{StaticResource FlatButton}" Padding="8,4" FontSize="11" Margin="4,0,0,0"
                                    Command="{Binding SaveConsoleCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBox Grid.Row="1" x:Name="ConsoleOutput" IsReadOnly="True"
                         Background="{StaticResource BgDark}" Foreground="#22c55e"
                         BorderThickness="0" Padding="10,8" Margin="0"
                         FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         Text="{Binding ConsoleOutput, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>

                <Border Grid.Row="2" Padding="8" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="CommandInput" Style="{StaticResource HexTextBox}"
                                 Padding="8,8" FontSize="12"
                                 KeyDown="CommandInput_KeyDown"
                                 Text="{Binding InputCommand, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Content="Send" Style="{StaticResource AccentButton}"
                                Padding="16,8" Margin="6,0,0,0"
                                Command="{Binding SendCommandCommand}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
