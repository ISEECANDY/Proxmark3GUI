<UserControl x:Class="Proxmark3GUI.Views.AntennaDiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="950"
             Background="{StaticResource BgDark}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="&#x1F4E1; Antenna Diagnostics" Style="{StaticResource PanelTitle}"/>
        <TextBlock Grid.Row="0" Text="Advanced antenna measurement and tuning diagnostics"
                   Style="{StaticResource PanelSubtitle}" Margin="0,28,0,0"/>

        <!-- Header with Run Full Diagnostic -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="BtnRunDiagnostic" Content="&#x25B6; Run Full Diagnostic" Style="{StaticResource AccentButton}"
                    Padding="16,8" Click="BtnRunDiagnostic_Click"/>
            <Button x:Name="BtnRunHf" Content="HF Only" Style="{StaticResource FlatButton}"
                    Padding="12,8" Margin="8,0,0,0" Click="BtnRunHf_Click"/>
            <Button x:Name="BtnRunLf" Content="LF Only" Style="{StaticResource FlatButton}"
                    Padding="12,8" Margin="6,0,0,0" Click="BtnRunLf_Click"/>
            <TextBlock x:Name="TxtLastRun" Text="Last run: Never" Foreground="{StaticResource TextDim}" FontSize="12"
                       VerticalAlignment="Center" Margin="16,0,0,0"/>
        </StackPanel>

        <!-- HF Diagnostics -->
        <GroupBox Grid.Row="2" Style="{StaticResource DarkGroupBox}" Header="HF Diagnostics (13.56 MHz)" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Peak Voltage -->
                <Border Grid.Column="0" Background="{StaticResource BgDark}" CornerRadius="6" Padding="12,10" Margin="0,0,4,0">
                    <StackPanel>
                        <TextBlock Text="Peak Voltage" Foreground="{StaticResource TextDim}" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtHfVoltage" Text="--.- V" Foreground="{StaticResource AccentCyan}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <Rectangle x:Name="BarHfVoltage" Width="100" Height="8" RadiusX="4" RadiusY="4" Margin="0,6,0,0">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#22c55e" Offset="0"/>
                                    <GradientStop Color="#eab308" Offset="0.6"/>
                                    <GradientStop Color="#ef4444" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </StackPanel>
                </Border>

                <!-- Frequency -->
                <Border Grid.Column="1" Background="{StaticResource BgDark}" CornerRadius="6" Padding="12,10" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="Frequency" Foreground="{StaticResource TextDim}" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtHfFreq" Text="-.--- MHz" Foreground="{StaticResource AccentCyan}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtHfFreqDev" Text="Dev: --" Foreground="{StaticResource TextDim}" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- VSWR -->
                <Border Grid.Column="2" Background="{StaticResource BgDark}" CornerRadius="6" Padding="12,10" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="VSWR" Foreground="{StaticResource TextDim}" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtHfVswr" Text="-.--" Foreground="{StaticResource AccentGreen}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtHfVswrStatus" Text="Good (&lt; 2.0)" Foreground="{StaticResource AccentGreen}" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Impedance -->
                <Border Grid.Column="3" Background="{StaticResource BgDark}" CornerRadius="6" Padding="12,10" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="Impedance" Foreground="{StaticResource TextDim}" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtHfImpedanceR" Text="R: --.- &#x03A9;" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtHfImpedanceX" Text="X: --.- &#x03A9;" Foreground="{StaticResource TextSecondary}" FontSize="14" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Q Factor -->
                <Border Grid.Column="4" Background="{StaticResource BgDark}" CornerRadius="6" Padding="12,10" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="Q Factor" Foreground="{StaticResource TextDim}" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtHfQ" Text="--.-" Foreground="{StaticResource AccentSecondary}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <Rectangle Width="100" Height="8" Fill="{StaticResource BgLight}" RadiusX="4" RadiusY="4" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Voltage Divider -->
                <Border Grid.Column="5" Background="{StaticResource BgDark}" CornerRadius="6" Padding="12,10" Margin="4,0,0,0">
                    <StackPanel>
                        <TextBlock Text="V. Divider" Foreground="{StaticResource TextDim}" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtHfVdiv" Text="--.---" Foreground="{StaticResource TextPrimary}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtHfVdivPct" Text="--%" Foreground="{StaticResource TextDim}" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </GroupBox>

        <!-- LF Diagnostics -->
        <GroupBox Grid.Row="3" Style="{StaticResource DarkGroupBox}" Header="LF Diagnostics (125 kHz)" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Peak Voltage -->
                <Border Grid.Column="0" Background="{StaticResource BgDark}" CornerRadius="6" Padding="12,10" Margin="0,0,4,0">
                    <StackPanel>
                        <TextBlock Text="Peak Voltage" Foreground="{StaticResource TextDim}" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtLfVoltage" Text="--.- V" Foreground="{StaticResource AccentBlue}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <Rectangle Width="100" Height="8" RadiusX="4" RadiusY="4" Margin="0,6,0,0">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#3b82f6" Offset="0"/>
                                    <GradientStop Color="#22c55e" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </StackPanel>
                </Border>

                <!-- Frequency -->
                <Border Grid.Column="1" Background="{StaticResource BgDark}" CornerRadius="6" Padding="12,10" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="Frequency" Foreground="{StaticResource TextDim}" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtLfFreq" Text="---.- kHz" Foreground="{StaticResource AccentBlue}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtLfFreqDev" Text="Dev: --" Foreground="{StaticResource TextDim}" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- VSWR -->
                <Border Grid.Column="2" Background="{StaticResource BgDark}" CornerRadius="6" Padding="12,10" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="VSWR" Foreground="{StaticResource TextDim}" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtLfVswr" Text="-.--" Foreground="{StaticResource AccentGreen}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtLfVswrStatus" Text="Good (&lt; 2.0)" Foreground="{StaticResource AccentGreen}" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Impedance -->
                <Border Grid.Column="3" Background="{StaticResource BgDark}" CornerRadius="6" Padding="12,10" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="Impedance" Foreground="{StaticResource TextDim}" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtLfImpedanceR" Text="R: --.- &#x03A9;" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtLfImpedanceX" Text="X: --.- &#x03A9;" Foreground="{StaticResource TextSecondary}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Inductance -->
                <Border Grid.Column="4" Background="{StaticResource BgDark}" CornerRadius="6" Padding="12,10" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="Inductance" Foreground="{StaticResource TextDim}" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtLfInductance" Text="---.- &#x00B5;H" Foreground="{StaticResource AccentOrange}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtLfIndStatus" Text="Nominal" Foreground="{StaticResource AccentGreen}" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Capacitance -->
                <Border Grid.Column="5" Background="{StaticResource BgDark}" CornerRadius="6" Padding="12,10" Margin="4,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Capacitance" Foreground="{StaticResource TextDim}" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtLfCapacitance" Text="---.- pF" Foreground="{StaticResource AccentOrange}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtLfCapStatus" Text="Nominal" Foreground="{StaticResource AccentGreen}" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </GroupBox>

        <!-- Auto-Tune Section -->
        <GroupBox Grid.Row="4" Style="{StaticResource DarkGroupBox}" Header="Auto-Tune" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button x:Name="BtnAutoTune" Grid.Row="0" Grid.Column="0" Content="&#x1F3B5; Auto-Tune" Style="{StaticResource SuccessButton}"
                        Padding="12,8" Click="BtnAutoTune_Click"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                    <TextBlock Text="Target Q Factor:" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtTargetQ" Style="{StaticResource DarkTextBox}" Width="60" Text="35"/>
                </StackPanel>

                <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" x:Name="TxtRecommendations" Style="{StaticResource DarkTextBox}"
                         IsReadOnly="True" Height="60" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                         Text="Auto-tune recommendations will appear here..." Margin="0,8,0,0"/>
            </Grid>
        </GroupBox>

        <!-- History -->
        <GroupBox Grid.Row="5" Style="{StaticResource DarkGroupBox}" Header="Measurement History (Last 10)">
            <ListView x:Name="LvHistory" Style="{StaticResource DarkListView}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Time" Width="80" DisplayMemberBinding="{Binding Timestamp}"/>
                        <GridViewColumn Header="Type" Width="40" DisplayMemberBinding="{Binding Type}"/>
                        <GridViewColumn Header="Voltage" Width="70" DisplayMemberBinding="{Binding Voltage}"/>
                        <GridViewColumn Header="Freq" Width="90" DisplayMemberBinding="{Binding Frequency}"/>
                        <GridViewColumn Header="VSWR" Width="55" DisplayMemberBinding="{Binding Vswr}"/>
                        <GridViewColumn Header="Q" Width="50" DisplayMemberBinding="{Binding QFactor}"/>
                        <GridViewColumn Header="V.Div" Width="60" DisplayMemberBinding="{Binding VDiv}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>

        <!-- Status Bar -->
        <Border Grid.Row="6" Background="{StaticResource BgMedium}" CornerRadius="6" Padding="12,8" Margin="0,8,0,0">
            <TextBlock x:Name="TxtStatus" Text="Ready. Click 'Run Full Diagnostic' to measure antenna parameters."
                       Foreground="{StaticResource TextDim}" FontSize="12"/>
        </Border>
    </Grid>
</UserControl>
