<UserControl x:Class="Proxmark3GUI.Views.AttackSchedulerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="950"
             Background="{StaticResource BgDark}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="&#x1F4C5; Attack Scheduler" Style="{StaticResource PanelTitle}"/>
        <TextBlock Grid.Row="0" Text="Queue and schedule multiple key recovery attacks"
                   Style="{StaticResource PanelSubtitle}" Margin="0,28,0,0"/>

        <!-- Add Job Form -->
        <GroupBox Grid.Row="1" Style="{StaticResource DarkGroupBox}" Header="Add Attack Job" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Job Name -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Job Name:" Foreground="{StaticResource TextSecondary}" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,12,6"/>
                <TextBox x:Name="TxtJobName" Grid.Row="0" Grid.Column="1" Style="{StaticResource DarkTextBox}" Width="250" Text="" Margin="0,0,0,6"/>

                <!-- Attack Type -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Attack Type:" Foreground="{StaticResource TextSecondary}" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,12,6"/>
                <ComboBox x:Name="CmbAttackType" Grid.Row="1" Grid.Column="1" Style="{StaticResource DarkComboBox}" Width="250" Margin="0,0,0,6">
                    <ComboBoxItem Content="Hardnested" IsSelected="True"/>
                    <ComboBoxItem Content="StaticNested"/>
                    <ComboBoxItem Content="Darkside"/>
                    <ComboBoxItem Content="Mfkey32"/>
                    <ComboBoxItem Content="iCLASS LOCLASS"/>
                    <ComboBoxItem Content="FM11RF08S Backdoor"/>
                </ComboBox>

                <!-- Key Type -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Key Type:" Foreground="{StaticResource TextSecondary}" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,12,6"/>
                <ComboBox x:Name="CmbJobKeyType" Grid.Row="2" Grid.Column="1" Style="{StaticResource DarkComboBox}" Width="250" Margin="0,0,0,6">
                    <ComboBoxItem Content="Key A" IsSelected="True"/>
                    <ComboBoxItem Content="Key B"/>
                    <ComboBoxItem Content="Both"/>
                </ComboBox>

                <!-- Repeat Options -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Repeat:" Foreground="{StaticResource TextSecondary}" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,12,6"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                    <ComboBox x:Name="CmbRepeatMode" Style="{StaticResource DarkComboBox}" Width="140" SelectionChanged="CmbRepeatMode_SelectionChanged">
                        <ComboBoxItem Content="Run Once" IsSelected="True"/>
                        <ComboBoxItem Content="Repeat N Times"/>
                        <ComboBoxItem Content="Continuous"/>
                    </ComboBox>
                    <TextBox x:Name="TxtRepeatCount" Style="{StaticResource DarkTextBox}" Width="60" Text="1" Margin="8,0,0,0" IsEnabled="False"/>
                    <TextBlock Text="Delay (s):" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <TextBox x:Name="TxtDelay" Style="{StaticResource DarkTextBox}" Width="60" Text="5" Margin="0,0,0,0"/>
                </StackPanel>

                <!-- Dictionary File -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Dict File:" Foreground="{StaticResource TextSecondary}" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="TxtDictPath" Style="{StaticResource DarkTextBox}" Width="200" Text="keys.dic"/>
                    <Button Content="Browse" Style="{StaticResource FlatButton}" Padding="10,6" Margin="8,0,0,0" Click="BtnBrowseDict_Click"/>
                    <Button x:Name="BtnAddJob" Content="&#x2795; Add Job" Style="{StaticResource AccentButton}" Padding="12,6" Margin="16,0,0,0" Click="BtnAddJob_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Job Queue Controls -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnStartAll" Content="&#x25B6; Start All" Style="{StaticResource SuccessButton}" Padding="12,6" Click="BtnStartAll_Click"/>
            <Button x:Name="BtnStopAll" Content="&#x23F9; Stop All" Style="{StaticResource DangerButton}" Padding="12,6" Margin="6,0,0,0" Click="BtnStopAll_Click"/>
            <Button x:Name="BtnRemoveSelected" Content="&#x2716; Remove Selected" Style="{StaticResource FlatButton}" Padding="12,6" Margin="6,0,0,0" Click="BtnRemoveSelected_Click"/>
            <Button x:Name="BtnClearQueue" Content="Clear Queue" Style="{StaticResource FlatButton}" Padding="12,6" Margin="6,0,0,0" Click="BtnClearQueue_Click"/>
            <TextBlock x:Name="TxtProgress" Text="Completed: 0 / Total: 0" Foreground="{StaticResource TextSecondary}" FontSize="12"
                       VerticalAlignment="Center" Margin="16,0,0,0"/>
        </StackPanel>

        <!-- Job Queue + Details Split -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Job Queue -->
            <ListView Grid.Column="0" x:Name="LvJobQueue" Style="{StaticResource DarkListView}" SelectionChanged="LvJobQueue_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="#" Width="40" DisplayMemberBinding="{Binding Index}"/>
                        <GridViewColumn Header="Name" Width="160" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="Attack Type" Width="110" DisplayMemberBinding="{Binding AttackType}"/>
                        <GridViewColumn Header="Key Type" Width="60" DisplayMemberBinding="{Binding KeyType}"/>
                        <GridViewColumn Header="Repeat" Width="60" DisplayMemberBinding="{Binding RepeatCount}"/>
                        <GridViewColumn Header="Status" Width="80" DisplayMemberBinding="{Binding Status}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Selected Job Details -->
            <GroupBox Grid.Column="1" Style="{StaticResource DarkGroupBox}" Header="Job Details" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="Name:" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,0,0,2"/>
                    <TextBlock x:Name="TxtDetailName" Text="-" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>

                    <TextBlock Text="Attack:" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,0,0,2"/>
                    <TextBlock x:Name="TxtDetailAttack" Text="-" Foreground="{StaticResource TextPrimary}" FontSize="12" Margin="0,0,0,8"/>

                    <TextBlock Text="Key Type:" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,0,0,2"/>
                    <TextBlock x:Name="TxtDetailKeyType" Text="-" Foreground="{StaticResource TextPrimary}" FontSize="12" Margin="0,0,0,8"/>

                    <TextBlock Text="Repeat:" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,0,0,2"/>
                    <TextBlock x:Name="TxtDetailRepeat" Text="-" Foreground="{StaticResource TextPrimary}" FontSize="12" Margin="0,0,0,8"/>

                    <TextBlock Text="Status:" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,0,0,2"/>
                    <TextBlock x:Name="TxtDetailStatus" Text="-" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,8"/>

                    <TextBlock Text="Found Keys:" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtDetailKeys" Style="{StaticResource HexTextBox}" IsReadOnly="True" Height="80"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Text="" Margin="0,0,0,8"/>

                    <ProgressBar x:Name="ProgressJob" Height="12" Value="0" Maximum="100"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- Results Summary -->
        <GroupBox Grid.Row="4" Style="{StaticResource DarkGroupBox}" Header="Results Summary" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="Total Jobs" Foreground="{StaticResource TextDim}" FontSize="10" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtTotalJobs" Text="0" Foreground="{StaticResource TextPrimary}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="Completed" Foreground="{StaticResource TextDim}" FontSize="10" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtCompletedJobs" Text="0" Foreground="{StaticResource AccentGreen}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="Running" Foreground="{StaticResource TextDim}" FontSize="10" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtRunningJobs" Text="0" Foreground="{StaticResource AccentCyan}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock Text="Keys Found" Foreground="{StaticResource TextDim}" FontSize="10" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtTotalKeys" Text="0" Foreground="{StaticResource AccentOrange}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Status Bar -->
        <Border Grid.Row="5" Background="{StaticResource BgMedium}" CornerRadius="6" Padding="12,8" Margin="0,8,0,0">
            <TextBlock x:Name="TxtStatus" Text="Ready. Add jobs to the queue and click Start All."
                       Foreground="{StaticResource TextDim}" FontSize="12"/>
        </Border>
    </Grid>
</UserControl>
