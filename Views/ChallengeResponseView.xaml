<UserControl x:Class="Proxmark3GUI.Views.ChallengeResponseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="950"
             Background="{StaticResource BgDark}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Panel Title -->
        <TextBlock Grid.Row="0" Text="&#x1F510; Challenge-Response" Style="{StaticResource PanelTitle}"/>
        <TextBlock Grid.Row="0" Text="Capture, analyze, and replay MIFARE authentication nonce-response pairs"
                   Style="{StaticResource PanelSubtitle}" Margin="0,28,0,0"/>

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="BtnExport" Content="&#x1F4C2; Export" Style="{StaticResource FlatButton}" Padding="10,6" Margin="0,0,6,0" Click="BtnExport_Click"/>
            <Button x:Name="BtnImport" Content="&#x1F4C1; Import" Style="{StaticResource FlatButton}" Padding="10,6" Margin="0,0,6,0" Click="BtnImport_Click"/>
            <Button x:Name="BtnClear" Content="Clear" Style="{StaticResource FlatButton}" Padding="10,6" Margin="0,0,6,0" Click="BtnClear_Click"/>
            <Separator Width="1" Background="{StaticResource BorderLight}" Margin="6,2"/>
            <Button x:Name="BtnAutoCapture" Content="&#x1F534; Auto-Capture: OFF" Style="{StaticResource FlatButton}"
                    Padding="12,6" Margin="0,0,6,0" Click="BtnAutoCapture_Click"/>
            <Button x:Name="BtnReplay" Content="&#x25B6; Replay Selected" Style="{StaticResource AccentButton}"
                    Padding="12,6" Margin="0,0,0,0" Click="BtnReplay_Click" IsEnabled="False"/>
        </StackPanel>

        <!-- Statistics Bar -->
        <Border Grid.Row="2" Background="{StaticResource BgMedium}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Total Pairs" Foreground="{StaticResource TextDim}" FontSize="10"/>
                    <TextBlock x:Name="TxtTotalPairs" Text="0" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Valid" Foreground="{StaticResource TextDim}" FontSize="10"/>
                    <TextBlock x:Name="TxtValidPairs" Text="0" Foreground="{StaticResource AccentGreen}" FontSize="16" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Invalid" Foreground="{StaticResource TextDim}" FontSize="10"/>
                    <TextBlock x:Name="TxtInvalidPairs" Text="0" Foreground="{StaticResource AccentRed}" FontSize="16" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Unique Keys" Foreground="{StaticResource TextDim}" FontSize="10"/>
                    <TextBlock x:Name="TxtUniqueKeys" Text="0" Foreground="{StaticResource AccentCyan}" FontSize="16" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Ellipse x:Name="AutoCapIndicator" Width="10" Height="10" Fill="{StaticResource AccentRed}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtAutoCapStatus" Text="Auto-Capture Stopped" Foreground="{StaticResource TextDim}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- CR Pairs Table -->
        <ListView x:Name="LvCrPairs" Grid.Row="3" Style="{StaticResource DarkListView}" MinHeight="200"
                  SelectionChanged="LvCrPairs_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="#" Width="45" DisplayMemberBinding="{Binding PairNumber}"/>
                    <GridViewColumn Header="NR (Nonce)" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding NrHex}" FontFamily="Consolas" FontSize="12"
                                           Foreground="{StaticResource AccentCyan}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="AR (Response)" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ArHex}" FontFamily="Consolas" FontSize="12"
                                           Foreground="{StaticResource AccentSecondary}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Key" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding KeyHex}" FontFamily="Consolas" FontSize="12"
                                           Foreground="{StaticResource AccentYellow}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Valid" Width="60">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ValidStatus}" FontWeight="Bold" FontSize="14">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsValid}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentRed}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Timestamp" Width="140" DisplayMemberBinding="{Binding Timestamp, StringFormat=\{0:HH:mm:ss.fff\}}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Selected Pair Detail -->
        <Border x:Name="DetailPanel" Grid.Row="4" Background="{StaticResource BgMedium}" CornerRadius="6"
                Padding="16" Margin="0,8,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="SELECTED PAIR DETAIL" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="NR (Nonce Reader):" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,12,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DetailNr" Text="-" Foreground="{StaticResource AccentCyan}" FontSize="12" FontFamily="Consolas" Margin="0,0,0,4"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="AR (Answer Reader):" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,12,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DetailAr" Text="-" Foreground="{StaticResource AccentSecondary}" FontSize="12" FontFamily="Consolas" Margin="0,0,0,4"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Key:" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,12,4"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DetailKey" Text="-" Foreground="{StaticResource AccentYellow}" FontSize="12" FontFamily="Consolas" Margin="0,0,0,4"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Byte Breakdown:" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,12,4"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DetailBytes" Text="-" Foreground="{StaticResource TextPrimary}" FontSize="11" FontFamily="Consolas" Margin="0,0,0,4"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Validation:" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="DetailValidation" Text="-" Foreground="{StaticResource TextPrimary}" FontSize="12"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="5" Background="{StaticResource BgMedium}" CornerRadius="6" Padding="12,8" Margin="0,8,0,0">
            <TextBlock x:Name="TxtStatus" Text="Ready. Enable auto-capture to log CR pairs from sniffed traffic."
                       Foreground="{StaticResource TextDim}" FontSize="12"/>
        </Border>
    </Grid>
</UserControl>
