<UserControl x:Class="Proxmark3GUI.Views.DataConversionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="950"
             Background="{StaticResource BgDark}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="&#x1F500; Data Conversion" Style="{StaticResource PanelTitle}"/>
        <TextBlock Grid.Row="0" Text="Convert between tag dump formats: Bin, EML, JSON, MFD, Trace"
                   Style="{StaticResource PanelSubtitle}" Margin="0,28,0,0"/>

        <!-- Conversion Configuration -->
        <GroupBox Grid.Row="1" Style="{StaticResource DarkGroupBox}" Header="Conversion Settings" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Source Format -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Source Format:" Foreground="{StaticResource TextSecondary}" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,12,8"/>
                <ComboBox x:Name="CmbSourceFormat" Grid.Row="0" Grid.Column="1" Style="{StaticResource DarkComboBox}" Width="200" Margin="0,0,0,8">
                    <ComboBoxItem Content="Bin (.bin)" IsSelected="True"/>
                    <ComboBoxItem Content="EML (.eml)"/>
                    <ComboBoxItem Content="JSON (.json)"/>
                    <ComboBoxItem Content="MFD (.mfd)"/>
                    <ComboBoxItem Content="Trace (.trace)"/>
                </ComboBox>

                <!-- Target Format -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Target Format:" Foreground="{StaticResource TextSecondary}" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,12,8"/>
                <ComboBox x:Name="CmbTargetFormat" Grid.Row="1" Grid.Column="1" Style="{StaticResource DarkComboBox}" Width="200" Margin="0,0,0,8">
                    <ComboBoxItem Content="EML (.eml)" IsSelected="True"/>
                    <ComboBoxItem Content="Bin (.bin)"/>
                    <ComboBoxItem Content="JSON (.json)"/>
                    <ComboBoxItem Content="MFD (.mfd)"/>
                    <ComboBoxItem Content="Trace (.trace)"/>
                </ComboBox>

                <!-- Source File -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Source File:" Foreground="{StaticResource TextSecondary}" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,12,8"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox x:Name="TxtSourcePath" Style="{StaticResource DarkTextBox}" Width="350" Text=""/>
                    <Button Content="Browse" Style="{StaticResource FlatButton}" Padding="10,6" Margin="8,0,0,0" Click="BtnBrowseSource_Click"/>
                </StackPanel>

                <!-- Target File -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Target File:" Foreground="{StaticResource TextSecondary}" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,12,8"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox x:Name="TxtTargetPath" Style="{StaticResource DarkTextBox}" Width="350" Text=""/>
                    <Button Content="Browse" Style="{StaticResource FlatButton}" Padding="10,6" Margin="8,0,0,0" Click="BtnBrowseTarget_Click"/>
                </StackPanel>

                <!-- Batch Option -->
                <CheckBox x:Name="ChkBatch" Grid.Row="4" Grid.Column="1" Content="Batch conversion (convert all files in directory)"
                          Style="{StaticResource DarkCheckBox}" Margin="0,4,0,8"/>

                <!-- Convert Button -->
                <Button x:Name="BtnConvert" Grid.Row="5" Grid.Column="1" Content="&#x1F504; Convert" Style="{StaticResource AccentButton}"
                        Padding="16,8" HorizontalAlignment="Left" Click="BtnConvert_Click"/>
            </Grid>
        </GroupBox>

        <!-- Preview + Log in Split -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Preview Panel -->
            <GroupBox Grid.Column="0" Style="{StaticResource DarkGroupBox}" Header="Source File Preview (First 256 bytes)" Margin="0,0,6,0">
                <TextBox x:Name="TxtPreview" Style="{StaticResource HexTextBox}" IsReadOnly="True" FontSize="10"
                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AcceptsReturn="True"
                         Text="Hex preview of source file will appear here after selecting a file..."/>
            </GroupBox>

            <!-- Conversion Log -->
            <GroupBox Grid.Column="1" Style="{StaticResource DarkGroupBox}" Header="Conversion Log" Margin="6,0,0,0">
                <TextBox x:Name="TxtConvLog" Style="{StaticResource HexTextBox}" IsReadOnly="True" FontSize="10"
                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AcceptsReturn="True"
                         Text="Conversion operations log will appear here..."/>
            </GroupBox>
        </Grid>

        <!-- Format Info -->
        <GroupBox Grid.Row="3" Style="{StaticResource DarkGroupBox}" Header="Supported Formats" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource BgDark}" CornerRadius="4" Padding="12,10" Margin="0,0,4,0">
                    <StackPanel>
                        <TextBlock Text="BIN" Foreground="{StaticResource AccentCyan}" FontSize="13" FontWeight="Bold"/>
                        <TextBlock Text="Raw binary dump of card data. Block-by-block, 16 bytes per block." Foreground="{StaticResource TextDim}" FontSize="10" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{StaticResource BgDark}" CornerRadius="4" Padding="12,10" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="EML" Foreground="{StaticResource AccentGreen}" FontSize="13" FontWeight="Bold"/>
                        <TextBlock Text="Emulator format. Hex data per block line, used by mfoc/emulator tools." Foreground="{StaticResource TextDim}" FontSize="10" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource BgDark}" CornerRadius="4" Padding="12,10" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="JSON" Foreground="{StaticResource AccentOrange}" FontSize="13" FontWeight="Bold"/>
                        <TextBlock Text="Structured JSON with metadata, keys, and block data in hex fields." Foreground="{StaticResource TextDim}" FontSize="10" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Background="{StaticResource BgDark}" CornerRadius="4" Padding="12,10" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="MFD" Foreground="{StaticResource AccentSecondary}" FontSize="13" FontWeight="Bold"/>
                        <TextBlock Text="MIFARE dump format. Includes header and block data." Foreground="{StaticResource TextDim}" FontSize="10" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Background="{StaticResource BgDark}" CornerRadius="4" Padding="12,10" Margin="4,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Trace" Foreground="{StaticResource AccentYellow}" FontSize="13" FontWeight="Bold"/>
                        <TextBlock Text="Communication trace log. Full ISO-14443 frame capture." Foreground="{StaticResource TextDim}" FontSize="10" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </GroupBox>

        <!-- Status Bar -->
        <Border Grid.Row="4" Background="{StaticResource BgMedium}" CornerRadius="6" Padding="12,8" Margin="0,0,0,0">
            <StackPanel Orientation="Horizontal">
                <ProgressBar x:Name="ProgressConvert" Width="200" Height="16" Value="0" Maximum="100"/>
                <TextBlock x:Name="TxtProgress" Text="Ready" Foreground="{StaticResource TextSecondary}" FontSize="12"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Spacer -->
        <Border Grid.Row="5"/>

        <!-- Bottom Status -->
        <Border Grid.Row="6" Background="{StaticResource BgMedium}" CornerRadius="6" Padding="12,8" Margin="0,8,0,0">
            <TextBlock x:Name="TxtStatus" Text="Ready. Select source and target formats, then choose files to convert."
                       Foreground="{StaticResource TextDim}" FontSize="12"/>
        </Border>
    </Grid>
</UserControl>
