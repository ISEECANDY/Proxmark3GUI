<UserControl x:Class="Proxmark3GUI.Views.DeviceInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="900"
             Background="{StaticResource BgDark}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>

            <!-- Panel Title -->
            <TextBlock Text="&#x1F4CA; Device Information" Style="{StaticResource PanelTitle}"/>
            <TextBlock Text="Hardware details and antenna diagnostics for your Proxmark3 device"
                       Style="{StaticResource PanelSubtitle}" Margin="0,0,0,20"/>

            <!-- Stat Cards Grid -->
            <TextBlock Text="DEVICE SPECS" Style="{StaticResource SectionLabel}"/>
            <UniformGrid Columns="4" Margin="0,0,0,16">

                <!-- Firmware Version -->
                <Border Background="{StaticResource BgMedium}" CornerRadius="8" Padding="14" Margin="4">
                    <StackPanel>
                        <TextBlock Text="Firmware Version" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtFirmwareVersion" Text="--" Foreground="{StaticResource TextPrimary}"
                                   FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Hardware Version -->
                <Border Background="{StaticResource BgMedium}" CornerRadius="8" Padding="14" Margin="4">
                    <StackPanel>
                        <TextBlock Text="Hardware Version" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtHardwareVersion" Text="--" Foreground="{StaticResource TextPrimary}"
                                   FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- PM3 UID -->
                <Border Background="{StaticResource BgMedium}" CornerRadius="8" Padding="14" Margin="4">
                    <StackPanel>
                        <TextBlock Text="PM3 UID" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtPm3Uid" Text="--" Foreground="{StaticResource TextPrimary}"
                                   FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- FPGA Version -->
                <Border Background="{StaticResource BgMedium}" CornerRadius="8" Padding="14" Margin="4">
                    <StackPanel>
                        <TextBlock Text="FPGA Version" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtFpgaVersion" Text="--" Foreground="{StaticResource TextPrimary}"
                                   FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Flash Size -->
                <Border Background="{StaticResource BgMedium}" CornerRadius="8" Padding="14" Margin="4">
                    <StackPanel>
                        <TextBlock Text="Flash Size" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtFlashSize" Text="--" Foreground="{StaticResource TextPrimary}"
                                   FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Serial Number -->
                <Border Background="{StaticResource BgMedium}" CornerRadius="8" Padding="14" Margin="4">
                    <StackPanel>
                        <TextBlock Text="Serial Number" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtSerialNumber" Text="--" Foreground="{StaticResource TextPrimary}"
                                   FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Bootloader Version -->
                <Border Background="{StaticResource BgMedium}" CornerRadius="8" Padding="14" Margin="4">
                    <StackPanel>
                        <TextBlock Text="Bootloader Version" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtBootloaderVersion" Text="--" Foreground="{StaticResource TextPrimary}"
                                   FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- UART Speed -->
                <Border Background="{StaticResource BgMedium}" CornerRadius="8" Padding="14" Margin="4">
                    <StackPanel>
                        <TextBlock Text="UART Speed" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtUartSpeed" Text="--" Foreground="{StaticResource TextPrimary}"
                                   FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,20">
                <Button x:Name="BtnRefresh" Content="&#x1F504; Refresh" Style="{StaticResource AccentButton}"
                        Padding="16,8" Margin="0,0,8,0" Click="BtnRefresh_Click"/>
                <Button x:Name="BtnDetectTags" Content="&#x1F4E1; Detect Tags" Style="{StaticResource FlatButton}"
                        Padding="16,8" Margin="0,0,8,0" Click="BtnDetectTags_Click"/>
            </StackPanel>

            <Border Background="{StaticResource BgMedium}" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                <TextBox x:Name="TxtTagSearchResults" Style="{StaticResource DarkTextBox}" Height="140" IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Text="Search results will appear here..."/>
            </Border>

            <!-- FPGA Status Section -->
            <GroupBox Style="{StaticResource DarkGroupBox}" Header="&#x1F527; FPGA Status">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton x:Name="RbFpgaReady" Content="Ready" Foreground="{StaticResource TextPrimary}"
                                     Margin="0,0,20,0" GroupName="FpgaState" IsChecked="True"/>
                        <RadioButton x:Name="RbFpgaLoading" Content="Loading" Foreground="{StaticResource TextPrimary}"
                                     Margin="0,0,20,0" GroupName="FpgaState"/>
                        <RadioButton x:Name="RbFpgaError" Content="Error" Foreground="{StaticResource TextPrimary}"
                                     GroupName="FpgaState"/>
                    </StackPanel>

                    <!-- LED Indicators -->
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="LED A" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                            <Ellipse x:Name="LedA" Width="14" Height="14" Fill="{StaticResource TextDim}" Stroke="{StaticResource BorderLight}" StrokeThickness="1"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="LED B" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                            <Ellipse x:Name="LedB" Width="14" Height="14" Fill="{StaticResource TextDim}" Stroke="{StaticResource BorderLight}" StrokeThickness="1"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="LED C" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                            <Ellipse x:Name="LedC" Width="14" Height="14" Fill="{StaticResource TextDim}" Stroke="{StaticResource BorderLight}" StrokeThickness="1"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="LED D" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                            <Ellipse x:Name="LedD" Width="14" Height="14" Fill="{StaticResource TextDim}" Stroke="{StaticResource BorderLight}" StrokeThickness="1"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Antenna Diagnostics -->
            <TextBlock Text="ANTENNA DIAGNOSTICS" Style="{StaticResource SectionLabel}"/>
            <UniformGrid Columns="4" Margin="0,0,0,16">

                <Border Background="{StaticResource BgMedium}" CornerRadius="8" Padding="14" Margin="4">
                    <StackPanel>
                        <TextBlock Text="HF Peak V" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtHfPeakV" Text="-- V" Foreground="{StaticResource AccentCyan}"
                                   FontSize="16" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource BgMedium}" CornerRadius="8" Padding="14" Margin="4">
                    <StackPanel>
                        <TextBlock Text="HF Frequency" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtHfFreq" Text="-- MHz" Foreground="{StaticResource AccentCyan}"
                                   FontSize="16" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource BgMedium}" CornerRadius="8" Padding="14" Margin="4">
                    <StackPanel>
                        <TextBlock Text="LF Peak V" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtLfPeakV" Text="-- V" Foreground="{StaticResource AccentOrange}"
                                   FontSize="16" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource BgMedium}" CornerRadius="8" Padding="14" Margin="4">
                    <StackPanel>
                        <TextBlock Text="LF Frequency" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtLfFreq" Text="-- kHz" Foreground="{StaticResource AccentOrange}"
                                   FontSize="16" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
