<UserControl x:Class="Proxmark3GUI.Views.PowerManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="950"
             Background="{StaticResource BgDark}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>

            <!-- Panel Title -->
            <TextBlock Text="&#x26A1; Power Management" Style="{StaticResource PanelTitle}"/>
            <TextBlock Text="Monitor power consumption, battery status, and field activity"
                       Style="{StaticResource PanelSubtitle}"/>

            <!-- Refresh Button -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button x:Name="BtnRefresh" Content="&#x21BB; Refresh" Style="{StaticResource AccentButton}"
                        Padding="14,8" Margin="0,0,8,0" Click="BtnRefresh_Click"/>
                <TextBlock x:Name="TxtLastRefresh" Text="Last refresh: --" Foreground="{StaticResource TextDim}"
                           FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Power Status Cards -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Battery Status -->
                <Border Grid.Column="0" Background="{StaticResource BgMedium}" CornerRadius="8" Padding="20" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="BATTERY" Foreground="{StaticResource TextDim}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <!-- Voltage -->
                        <TextBlock Text="Voltage" Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="0,0,0,2"/>
                        <TextBlock x:Name="TxtBatteryVoltage" Text="3.82 V" Foreground="{StaticResource TextPrimary}" FontSize="26" FontWeight="Bold" Margin="0,0,0,8"/>
                        <!-- Charge Bar -->
                        <TextBlock Text="Charge Level" Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="0,0,0,4"/>
                        <Border Background="{StaticResource BgDark}" CornerRadius="4" Height="20" Margin="0,0,0,4">
                            <Grid>
                                <Rectangle x:Name="BatteryBar" HorizontalAlignment="Left" Width="0" RadiusX="3" RadiusY="3">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Offset="0" Color="#ef4444"/>
                                            <GradientStop Offset="0.3" Color="#f97316"/>
                                            <GradientStop Offset="0.6" Color="#eab308"/>
                                            <GradientStop Offset="1" Color="#22c55e"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <TextBlock x:Name="TxtBatteryPercent" Text="0%" Foreground="{StaticResource TextPrimary}" FontSize="11"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <!-- Status -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse x:Name="BatteryIndicator" Width="8" Height="8" Fill="{StaticResource TextDim}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtBatteryStatus" Text="Unknown" Foreground="{StaticResource TextDim}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- USB & Field Status -->
                <Border Grid.Column="1" Background="{StaticResource BgMedium}" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <TextBlock Text="CONNECTION STATUS" Foreground="{StaticResource TextDim}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <!-- USB Status -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="USB:" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Ellipse x:Name="UsbIndicator" Width="10" Height="10" Fill="{StaticResource TextDim}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtUsbStatus" Text="Disconnected" Foreground="{StaticResource TextDim}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="USB Voltage:" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtUsbVoltage" Text="-- V" Foreground="{StaticResource TextPrimary}" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                        <!-- HF Field -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="HF Field:" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Ellipse x:Name="HfFieldIndicator" Width="10" Height="10" Fill="{StaticResource TextDim}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtHfField" Text="Inactive" Foreground="{StaticResource TextDim}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <!-- LF Field -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="LF Field:" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Ellipse x:Name="LfFieldIndicator" Width="10" Height="10" Fill="{StaticResource TextDim}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtLfField" Text="Inactive" Foreground="{StaticResource TextDim}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <!-- Field Voltage -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Field V:" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtFieldVoltage" Text="-- V" Foreground="{StaticResource TextPrimary}" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Power Consumption -->
            <TextBlock Text="POWER CONSUMPTION" Style="{StaticResource SectionLabel}"/>
            <Border Background="{StaticResource BgMedium}" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Text="Current Draw" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtCurrentDraw" Text="85 mA" Foreground="{StaticResource AccentOrange}" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="milliamps" Foreground="{StaticResource TextDim}" FontSize="10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Power Over Time" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                        <!-- Simple Canvas-based power graph placeholder -->
                        <Border Background="{StaticResource BgDark}" CornerRadius="4" Height="80" ClipToBounds="True">
                            <Canvas x:Name="PowerGraphCanvas" ClipToBounds="True">
                                <!-- Grid lines -->
                                <Line X1="0" Y1="20" X2="600" Y2="20" Stroke="#334155" StrokeThickness="1" StrokeDashArray="4,4"/>
                                <Line X1="0" Y1="40" X2="600" Y2="40" Stroke="#334155" StrokeThickness="1" StrokeDashArray="4,4"/>
                                <Line X1="0" Y1="60" X2="600" Y2="60" Stroke="#334155" StrokeThickness="1" StrokeDashArray="4,4"/>
                                <!-- Power trace line -->
                                <Polyline x:Name="PowerTraceLine" Points="0,70 50,65 100,60 150,55 200,50 250,48 300,45 350,42 400,38 450,35 500,30 550,28"
                                          Stroke="#3b82f6" StrokeThickness="2" Fill="Transparent"/>
                                <!-- Current marker -->
                                <Ellipse x:Name="PowerMarker" Canvas.Left="550" Canvas.Top="24" Width="8" Height="8"
                                         Fill="#22c55e" Stroke="{StaticResource BgDark}" StrokeThickness="2"/>
                            </Canvas>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Power Saving Options -->
            <TextBlock Text="POWER SAVING" Style="{StaticResource SectionLabel}"/>
            <GroupBox Style="{StaticResource DarkGroupBox}">
                <StackPanel>
                    <CheckBox x:Name="ChkAutoSleep" Content="Auto-sleep after inactivity" Style="{StaticResource DarkCheckBox}"
                              Margin="0,0,0,8" Click="ChkAutoSleep_Click"/>
                    <Grid Margin="20,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Timeout:" Foreground="{StaticResource TextDim}" FontSize="11" VerticalAlignment="Center"/>
                        <Slider x:Name="SliderSleepTimeout" Grid.Column="1" Style="{StaticResource DarkSlider}" Minimum="1" Maximum="30" Value="5"
                                Margin="8,0,8,0" ValueChanged="SliderSleepTimeout_ValueChanged"/>
                        <TextBlock Grid.Column="2" x:Name="TxtSleepTimeout" Text="5 min" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                    </Grid>
                    <CheckBox x:Name="ChkScreenDim" Content="Dim screen on idle" Style="{StaticResource DarkCheckBox}" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkFieldTimeout" Content="Auto-disable field after timeout" Style="{StaticResource DarkCheckBox}" Margin="0,0,0,8"/>
                    <Grid Margin="20,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Timeout:" Foreground="{StaticResource TextDim}" FontSize="11" VerticalAlignment="Center"/>
                        <Slider x:Name="SliderFieldTimeout" Grid.Column="1" Style="{StaticResource DarkSlider}" Minimum="5" Maximum="120" Value="30"
                                Margin="8,0,8,0" ValueChanged="SliderFieldTimeout_ValueChanged"/>
                        <TextBlock Grid.Column="2" x:Name="TxtFieldTimeout" Text="30 sec" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
