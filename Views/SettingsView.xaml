<UserControl x:Class="Proxmark3GUI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="900"
             Background="{StaticResource BgDark}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Panel Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,4">
            <TextBlock Text="&#x2699; Settings" Style="{StaticResource PanelTitle}"/>
            <TextBlock Text="Configure connection, display, attack, and logging preferences"
                       Style="{StaticResource PanelSubtitle}"/>
        </StackPanel>

        <!-- Tab Control -->
        <TabControl Grid.Row="1" Margin="0,0,0,16">

            <!-- Connection Tab -->
            <TabItem Header="&#x1F517; Connection">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <!-- Port Name -->
                        <TextBlock Text="Serial Port" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbPortName" Style="{StaticResource DarkComboBox}" Width="300" HorizontalAlignment="Left" Margin="0,0,0,16">
                            <ComboBoxItem Content="COM3"/>
                            <ComboBoxItem Content="COM4"/>
                            <ComboBoxItem Content="/dev/ttyACM0"/>
                            <ComboBoxItem Content="/dev/ttyUSB0"/>
                        </ComboBox>
                        <Button x:Name="BtnRefreshPorts" Content="⟳ Refresh Ports" Style="{StaticResource FlatButton}"
                                Width="140" HorizontalAlignment="Left" Margin="0,0,0,16"
                                Click="BtnRefreshPorts_Click"/>

                        <!-- Baud Rate -->
                        <TextBlock Text="Baud Rate" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbBaudRate" Style="{StaticResource DarkComboBox}" Width="300" HorizontalAlignment="Left" Margin="0,0,0,16">
                            <ComboBoxItem Content="9600"/>
                            <ComboBoxItem Content="19200"/>
                            <ComboBoxItem Content="38400"/>
                            <ComboBoxItem Content="57600"/>
                            <ComboBoxItem Content="115200" IsSelected="True"/>
                            <ComboBoxItem Content="460800"/>
                        </ComboBox>

                        <!-- PM3 Executable -->
                        <TextBlock Text="PM3 Executable Path" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBox x:Name="TxtPm3Path" Style="{StaticResource DarkTextBox}" Width="300"
                                     Text="pm3" VerticalAlignment="Center"/>
                            <Button Content="Browse" Style="{StaticResource FlatButton}" Padding="10,6"
                                    Margin="8,0,0,0" Click="BtnBrowsePm3_Click"/>
                        </StackPanel>

                        <!-- Auto-connect -->
                        <CheckBox x:Name="ChkAutoConnect" Content="Auto-connect on startup"
                                  Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>

                        <!-- Connection Control Buttons -->
                        <TextBlock Text="Device Connection" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button x:Name="BtnConnect" Content="🔌 Connect to Device" Style="{StaticResource AccentButton}"
                                    Padding="12,8" Margin="0,0,8,0" Click="BtnConnect_Click"/>
                            <Button x:Name="BtnDisconnect" Content="🔌 Disconnect Device" Style="{StaticResource DangerButton}"
                                    Padding="12,8" Click="BtnDisconnect_Click"/>
                        </StackPanel>

                        <!-- Timeout -->
                        <TextBlock Text="Connection Timeout (seconds)" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <Slider x:Name="SldTimeout" Style="{StaticResource DarkSlider}" Width="300"
                                    Minimum="1" Maximum="30" Value="5" IsSnapToTickEnabled="True" TickFrequency="1"/>
                            <TextBlock x:Name="TxtTimeoutValue" Text="5s" Foreground="{StaticResource TextPrimary}"
                                       FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Display Tab -->
            <TabItem Header="&#x1F4A1; Display">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <CheckBox x:Name="ChkShowTimestamps" Content="Show timestamps in console output"
                                  Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12" IsChecked="True"/>
                        <CheckBox x:Name="ChkShowCommandEcho" Content="Show command echo"
                                  Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16" IsChecked="True"/>

                        <!-- Max Console Lines -->
                        <TextBlock Text="Max Console Lines" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtMaxConsoleLines" Style="{StaticResource DarkTextBox}" Width="120"
                                 Text="1000" HorizontalAlignment="Left" Margin="0,0,0,16"/>

                        <!-- Font Size -->
                        <TextBlock Text="Console Font Size" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Slider x:Name="SldFontSize" Style="{StaticResource DarkSlider}" Width="300"
                                    Minimum="8" Maximum="20" Value="11" IsSnapToTickEnabled="True" TickFrequency="1"
                                    ValueChanged="SldFontSize_ValueChanged"/>
                            <TextBlock x:Name="TxtFontSizeValue" Text="11px" Foreground="{StaticResource TextPrimary}"
                                       FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Color Theme -->
                        <TextBlock Text="Color Theme" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbColorTheme" Style="{StaticResource DarkComboBox}" Width="200" HorizontalAlignment="Left">
                            <ComboBoxItem Content="Dark Purple" IsSelected="True"/>
                            <ComboBoxItem Content="Dark Blue"/>
                            <ComboBoxItem Content="Dark Green"/>
                            <ComboBoxItem Content="Monokai"/>
                        </ComboBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Attack Tab -->
            <TabItem Header="&#x1F511; Attack">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <!-- Default Dictionary -->
                        <TextBlock Text="Default Dictionary Path" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBox x:Name="TxtDefaultDict" Style="{StaticResource DarkTextBox}" Width="300"
                                     Text="default.dic" VerticalAlignment="Center"/>
                            <Button Content="Browse" Style="{StaticResource FlatButton}" Padding="10,6"
                                    Margin="8,0,0,0" Click="BtnBrowseDefaultDict_Click"/>
                        </StackPanel>

                        <!-- Max Attack Timeout -->
                        <TextBlock Text="Max Attack Timeout (seconds)" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtMaxTimeout" Style="{StaticResource DarkTextBox}" Width="120"
                                 Text="300" HorizontalAlignment="Left" Margin="0,0,0,16"/>

                        <CheckBox x:Name="ChkAutoSaveDumps" Content="Auto-save dumps after cracking"
                                  Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12" IsChecked="True"/>
                        <CheckBox x:Name="ChkFastCheck" Content="Use fast check (may miss some keys)"
                                  Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>

                        <!-- Darkside Parameters -->
                        <TextBlock Text="DARKSIDE PARAMETERS" Style="{StaticResource SectionLabel}" Margin="0,8,0,8"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="X:" Foreground="{StaticResource TextSecondary}" Margin="0,0,4,8"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource DarkTextBox}" Width="80" Text="1" Margin="0,0,20,8"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Y:" Foreground="{StaticResource TextSecondary}" Margin="0,0,4,8"/>
                            <TextBox Grid.Row="0" Grid.Column="3" Style="{StaticResource DarkTextBox}" Width="80" Text="0" Margin="0,0,20,8"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Logging Tab -->
            <TabItem Header="&#x1F4DD; Logging">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <CheckBox x:Name="ChkEnableLogging" Content="Enable logging"
                                  Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16" IsChecked="True"/>

                        <!-- Log File Path -->
                        <TextBlock Text="Log File Path" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBox x:Name="TxtLogPath" Style="{StaticResource DarkTextBox}" Width="300"
                                     Text="pm3gui.log" VerticalAlignment="Center"/>
                            <Button Content="Browse" Style="{StaticResource FlatButton}" Padding="10,6"
                                    Margin="8,0,0,0" Click="BtnBrowseLog_Click"/>
                        </StackPanel>

                        <!-- Log Level -->
                        <TextBlock Text="Log Level" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbLogLevel" Style="{StaticResource DarkComboBox}" Width="200" HorizontalAlignment="Left" Margin="0,0,0,16">
                            <ComboBoxItem Content="Debug"/>
                            <ComboBoxItem Content="Info" IsSelected="True"/>
                            <ComboBoxItem Content="Warn"/>
                            <ComboBoxItem Content="Error"/>
                        </ComboBox>

                        <Button Content="&#x1F5D1; Clear Log File" Style="{StaticResource FlatButton}"
                                Padding="12,8" Click="BtnClearLog_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- Apply / Reset Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnApply" Content="&#x2705; Apply" Style="{StaticResource AccentButton}"
                    Padding="20,10" Margin="0,0,8,0" Click="BtnApply_Click"/>
            <Button x:Name="BtnReset" Content="&#x1F504; Reset to Defaults" Style="{StaticResource FlatButton}"
                    Padding="20,10" Click="BtnReset_Click"/>
        </StackPanel>

    </Grid>
</UserControl>
