<UserControl x:Class="Proxmark3GUI.Views.StandaloneModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="950"
             Background="{StaticResource BgDark}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>

            <!-- Panel Title -->
            <TextBlock Text="&#x1F3C1; Standalone Mode" Style="{StaticResource PanelTitle}"/>
            <TextBlock Text="Configure device standalone modes for operation without a computer"
                       Style="{StaticResource PanelSubtitle}"/>

            <!-- Mode Selection -->
            <TextBlock Text="MODE SELECTION" Style="{StaticResource SectionLabel}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <ComboBox x:Name="CmbMode" Style="{StaticResource DarkComboBox}" Width="280" SelectionChanged="CmbMode_SelectionChanged">
                    <ComboBoxItem Content="HF Reader" IsSelected="True"/>
                    <ComboBoxItem Content="LF Sniffer"/>
                    <ComboBoxItem Content="Tag Emulator"/>
                    <ComboBoxItem Content="Key Cracker"/>
                    <ComboBoxItem Content="MFUCK (Mifare Classic Universal Key)"/>
                    <ComboBoxItem Content="RATT (Relay Attack)"/>
                </ComboBox>
                <TextBlock x:Name="TxtModeDescription" Text="Detect and log HF RFID tags"
                           Foreground="{StaticResource TextDim}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>

            <!-- Mode Configuration Panels -->
            <TextBlock Text="MODE CONFIGURATION" Style="{StaticResource SectionLabel}"/>
            <GroupBox Style="{StaticResource DarkGroupBox}">
                <StackPanel>

                <!-- HF Reader Config -->
                <StackPanel x:Name="PanelHfReader">
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Tag Types:" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Top" Margin="0,0,12,0"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                            <CheckBox Content="ISO14443A / MIFARE" Style="{StaticResource DarkCheckBox}" IsChecked="True" Margin="0,0,0,4"/>
                            <CheckBox Content="ISO14443B" Style="{StaticResource DarkCheckBox}" Margin="0,0,0,4"/>
                            <CheckBox Content="ISO15693" Style="{StaticResource DarkCheckBox}" Margin="0,0,0,4"/>
                            <CheckBox Content="FeliCa" Style="{StaticResource DarkCheckBox}" Margin="0,0,0,4"/>
                            <CheckBox Content="iCLASS" Style="{StaticResource DarkCheckBox}"/>
                        </StackPanel>

                        <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Content="Beep on tag detect" Style="{StaticResource DarkCheckBox}" IsChecked="True" Margin="0,0,0,8"/>
                        <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Content="Log to flash memory" Style="{StaticResource DarkCheckBox}" IsChecked="True"/>
                    </Grid>
                </StackPanel>

                <!-- LF Sniffer Config -->
                <StackPanel x:Name="PanelLfSniffer" Visibility="Collapsed">
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Modulation:" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Top" Margin="0,0,12,0"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                            <CheckBox Content="ASK / AM" Style="{StaticResource DarkCheckBox}" IsChecked="True" Margin="0,0,0,4"/>
                            <CheckBox Content="PSK" Style="{StaticResource DarkCheckBox}" Margin="0,0,0,4"/>
                            <CheckBox Content="FSK" Style="{StaticResource DarkCheckBox}" Margin="0,0,0,4"/>
                            <CheckBox Content="Manchester / BiPhase" Style="{StaticResource DarkCheckBox}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Log Format:" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource DarkComboBox}" Width="200" Margin="0,0,0,10">
                            <ComboBoxItem Content="Binary (compact)" IsSelected="True"/>
                            <ComboBoxItem Content="Hex (readable)"/>
                            <ComboBoxItem Content="JSON"/>
                        </ComboBox>

                        <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Content="Include timestamps in log" Style="{StaticResource DarkCheckBox}" IsChecked="True"/>
                    </Grid>
                </StackPanel>

                <!-- Tag Emulator Config -->
                <StackPanel x:Name="PanelTagEmulator" Visibility="Collapsed">
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Profile:" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource DarkComboBox}" Width="250" Margin="0,0,0,10">
                            <ComboBoxItem Content="MIFARE Classic 1K" IsSelected="True"/>
                            <ComboBoxItem Content="MIFARE Classic 4K"/>
                            <ComboBoxItem Content="MIFARE Ultralight"/>
                            <ComboBoxItem Content="iCLASS"/>
                            <ComboBoxItem Content="EM410x"/>
                            <ComboBoxItem Content="HID Prox"/>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="UID:" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource HexTextBox}" Width="200" Text="046ED63E" Margin="0,0,0,0"/>
                    </Grid>
                </StackPanel>

                <!-- Key Cracker Config -->
                <StackPanel x:Name="PanelKeyCracker" Visibility="Collapsed">
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Target Sectors:" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="From" Foreground="{StaticResource TextDim}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox Style="{StaticResource DarkTextBox}" Width="50" Text="0" VerticalAlignment="Center"/>
                            <TextBlock Text="To" Foreground="{StaticResource TextDim}" FontSize="11" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            <TextBox Style="{StaticResource DarkTextBox}" Width="50" Text="15" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Dictionary Size:" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource DarkComboBox}" Width="200" Margin="0,0,0,10">
                            <ComboBoxItem Content="Small (100 keys)" IsSelected="True"/>
                            <ComboBoxItem Content="Medium (1,000 keys)"/>
                            <ComboBoxItem Content="Large (10,000 keys)"/>
                            <ComboBoxItem Content="Full dictionary"/>
                        </ComboBox>

                        <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Content="Save cracked keys to flash" Style="{StaticResource DarkCheckBox}" IsChecked="True"/>
                    </Grid>
                </StackPanel>

                <!-- MFUCK Config -->
                <StackPanel x:Name="PanelMfuck" Visibility="Collapsed">
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Attack Mode:" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource DarkComboBox}" Width="250" Margin="0,0,0,10">
                            <ComboBoxItem Content="Nested (fast, needs 1 key)" IsSelected="True"/>
                            <ComboBoxItem Content="Darkside (no key needed)"/>
                            <ComboBoxItem Content="Brute Force (slow)"/>
                        </ComboBox>

                        <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Content="Auto-start on first detected tag" Style="{StaticResource DarkCheckBox}" IsChecked="True"/>
                    </Grid>
                </StackPanel>

                <!-- RATT Config -->
                <StackPanel x:Name="PanelRatt" Visibility="Collapsed">
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Relay Mode:" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource DarkComboBox}" Width="250" Margin="0,0,0,10">
                            <ComboBoxItem Content="HF Relay" IsSelected="True"/>
                            <ComboBoxItem Content="LF Relay"/>
                        </ComboBox>

                        <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Content="Continuous relay mode" Style="{StaticResource DarkCheckBox}" IsChecked="True"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
            </GroupBox>

            <!-- Auto-Start -->
            <TextBlock Text="AUTO-START" Style="{StaticResource SectionLabel}"/>
            <GroupBox Style="{StaticResource DarkGroupBox}">
                <StackPanel>
                    <CheckBox x:Name="ChkAutoStart" Content="Enable auto-start on power-up" Style="{StaticResource DarkCheckBox}" IsChecked="False" Margin="0,0,0,8"/>
                    <Grid Margin="20,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Mode:" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox x:Name="CmbAutoStartMode" Style="{StaticResource DarkComboBox}" Width="250">
                            <ComboBoxItem Content="HF Reader" IsSelected="True"/>
                            <ComboBoxItem Content="LF Sniffer"/>
                            <ComboBoxItem Content="Key Cracker"/>
                            <ComboBoxItem Content="MFUCK"/>
                            <ComboBoxItem Content="RATT"/>
                        </ComboBox>
                    </Grid>
                    <Grid Margin="20,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Delay:" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Slider x:Name="SliderAutoStartDelay" Style="{StaticResource DarkSlider}" Minimum="0" Maximum="10" Value="0"
                                Margin="0,0,8,0" ValueChanged="SliderAutoStartDelay_ValueChanged"/>
                        <TextBlock Grid.Column="2" x:Name="TxtAutoStartDelay" Text="0 sec" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- Button Actions -->
            <TextBlock Text="BUTTON ACTIONS" Style="{StaticResource SectionLabel}"/>
            <GroupBox Style="{StaticResource DarkGroupBox}">
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Button 1:" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,8"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource DarkComboBox}" Width="280" Margin="0,0,0,8">
                        <ComboBoxItem Content="Start/Stop mode" IsSelected="True"/>
                        <ComboBoxItem Content="Read tag"/>
                        <ComboBoxItem Content="Emulate tag"/>
                        <ComboBoxItem Content="Crack keys"/>
                        <ComboBoxItem Content="No action"/>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Button 2:" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,8"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource DarkComboBox}" Width="280" Margin="0,0,0,8">
                        <ComboBoxItem Content="Save data to flash" IsSelected="True"/>
                        <ComboBoxItem Content="Toggle LED"/>
                        <ComboBoxItem Content="Change mode"/>
                        <ComboBoxItem Content="No action"/>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Long Press:" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource DarkComboBox}" Width="280">
                        <ComboBoxItem Content="Enter/Exit standalone mode" IsSelected="True"/>
                        <ComboBoxItem Content="Factory reset"/>
                        <ComboBoxItem Content="Shutdown"/>
                        <ComboBoxItem Content="No action"/>
                    </ComboBox>
                </Grid>
            </GroupBox>

            <!-- Apply Button -->
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="BtnApply" Content="&#x2705; Apply &amp; Upload to Device" Style="{StaticResource AccentButton}"
                        Padding="20,10" Margin="0,0,8,0" Click="BtnApply_Click"/>
                <Button Content="Reset to Defaults" Style="{StaticResource FlatButton}"
                        Padding="14,10" Click="BtnResetDefaults_Click"/>
            </StackPanel>

            <Border Background="{StaticResource BgMedium}" CornerRadius="8" Padding="14" Margin="0,16,0,0">
                <TextBox x:Name="TxtLog" Style="{StaticResource DarkTextBox}" Height="180" IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
