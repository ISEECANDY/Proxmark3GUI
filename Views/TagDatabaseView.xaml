<UserControl x:Class="Proxmark3GUI.Views.TagDatabaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="900"
             Background="{StaticResource BgDark}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Panel Title -->
        <StackPanel Grid.Row="0" Margin="24,16,24,4">
            <TextBlock Text="&#x1F4C3; Tag Database" Style="{StaticResource PanelTitle}"/>
            <TextBlock Text="Manage scanned and saved tag entries"
                       Style="{StaticResource PanelSubtitle}"/>
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{StaticResource BgMedium}" Padding="12,8" Margin="24,0,24,12"
                CornerRadius="6">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="TxtSearch" Style="{StaticResource DarkTextBox}" Width="200" Padding="10,6"
                         TextChanged="TxtSearch_TextChanged"/>
                <ComboBox x:Name="CmbFilterType" Style="{StaticResource DarkComboBox}" Width="150"
                          Margin="8,0,0,0" SelectionChanged="CmbFilterType_SelectionChanged">
                    <ComboBoxItem Content="All Types" IsSelected="True"/>
                    <ComboBoxItem Content="MIFARE Classic"/>
                    <ComboBoxItem Content="MIFARE DESFire"/>
                    <ComboBoxItem Content="NTAG"/>
                    <ComboBoxItem Content="HID Prox"/>
                    <ComboBoxItem Content="EM410x"/>
                </ComboBox>

                <Separator Width="1" Background="{StaticResource BorderLight}" Margin="16,2,16,2"/>

                <Button x:Name="BtnClearAll" Content="&#x1F5D1; Clear All" Style="{StaticResource FlatButton}"
                        Padding="10,6" Margin="0,0,6,0" Click="BtnClearAll_Click"/>
                <Button x:Name="BtnExport" Content="&#x1F4E4; Export" Style="{StaticResource FlatButton}"
                        Padding="10,6" Margin="0,0,6,0" Click="BtnExport_Click"/>
                <Button x:Name="BtnAddTag" Content="&#x2795; Add Tag" Style="{StaticResource AccentButton}"
                        Padding="10,6" Margin="0,0,6,0" Click="BtnAddTag_Click"/>
                <Button x:Name="BtnDeleteSelected" Content="&#x2716; Delete" Style="{StaticResource FlatButton}"
                        Padding="10,6" Click="BtnDeleteSelected_Click"/>
            </StackPanel>
        </Border>

        <!-- Main Tag ListView -->
        <ListView x:Name="LstTags" Grid.Row="2" Style="{StaticResource DarkListView}"
                  Margin="24,0,24,0" SelectionChanged="LstTags_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="UID" Width="140">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Uid}" Foreground="{StaticResource AccentSecondary}"
                                           FontWeight="SemiBold" FontFamily="Consolas" FontSize="12"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Type" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TagType}" Foreground="{StaticResource TextPrimary}" FontSize="12"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="ATQA" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Atqa}" Foreground="{StaticResource TextDim}" FontFamily="Consolas" FontSize="11"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="SAK" Width="60">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Sak}" Foreground="{StaticResource TextDim}" FontFamily="Consolas" FontSize="11"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Date Scanned" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DateScanned}" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Keys" Width="60">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding KeysFound}" Foreground="{StaticResource AccentGreen}" FontSize="12"
                                           FontWeight="SemiBold"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Notes" Width="180">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Notes}" Foreground="{StaticResource TextDim}" FontSize="11"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>

            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy UID" Click="MenuCopyUid_Click"/>
                    <MenuItem Header="View Dump" Click="MenuViewDump_Click"/>
                    <MenuItem Header="Export" Click="MenuExport_Click"/>
                    <Separator/>
                    <MenuItem Header="Delete" Click="MenuDelete_Click"/>
                </ContextMenu>
            </ListView.ContextMenu>
        </ListView>

        <!-- Scan Log -->
        <Border Grid.Row="3" Background="{StaticResource BgMedium}" CornerRadius="6" Padding="12" Margin="24,12,24,0">
            <TextBox x:Name="TxtScanLog" Style="{StaticResource DarkTextBox}" Height="180" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="{StaticResource BgMedium}" Padding="12,6" Margin="24,8,24,16"
                CornerRadius="6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,0,16,0">
                    <Run Text="Total: "/><Run x:Name="TxtTotalCount" Text="0" Foreground="{StaticResource TextPrimary}"/>
                </TextBlock>
                <TextBlock Foreground="{StaticResource TextDim}" FontSize="11">
                    <Run Text="Filtered: "/><Run x:Name="TxtFilteredCount" Text="0" Foreground="{StaticResource TextPrimary}"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
