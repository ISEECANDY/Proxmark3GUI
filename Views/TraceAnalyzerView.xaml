<UserControl x:Class="Proxmark3GUI.Views.TraceAnalyzerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1000"
             Background="{StaticResource BgDark}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Panel Title -->
        <TextBlock Grid.Row="0" Text="&#x1F50D; Trace Analyzer" Style="{StaticResource PanelTitle}"/>
        <TextBlock Grid.Row="0" Text="Inspect and analyze captured protocol traces"
                   Style="{StaticResource PanelSubtitle}" Margin="0,28,0,0"/>

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="BtnClear" Content="Clear" Style="{StaticResource FlatButton}" Padding="10,6" Margin="0,0,6,0" Click="BtnClear_Click"/>
            <Button x:Name="BtnExportPcap" Content="Export PCAP" Style="{StaticResource FlatButton}" Padding="10,6" Margin="0,0,6,0" Click="BtnExportPcap_Click"/>
            <Button x:Name="BtnExportCsv" Content="Export CSV" Style="{StaticResource FlatButton}" Padding="10,6" Margin="0,0,6,0" Click="BtnExportCsv_Click"/>
            <Button x:Name="BtnZoomFit" Content="Zoom Fit" Style="{StaticResource FlatButton}" Padding="10,6" Margin="0,0,6,0" Click="BtnZoomFit_Click"/>
            <Separator Width="1" Background="{StaticResource BorderLight}" Margin="6,2"/>
            <TextBlock Text="Filter:" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="6,0,4,0"/>
            <ComboBox x:Name="CmbFilter" Style="{StaticResource DarkComboBox}" Width="150" SelectionChanged="CmbFilter_SelectionChanged">
                <ComboBoxItem Content="All Protocols" IsSelected="True"/>
                <ComboBoxItem Content="ISO14443A"/>
                <ComboBoxItem Content="ISO15693"/>
                <ComboBoxItem Content="MIFARE Classic"/>
                <ComboBoxItem Content="MIFARE Ultralight"/>
                <ComboBoxItem Content="iCLASS"/>
                <ComboBoxItem Content="FeliCa"/>
                <ComboBoxItem Content="EM410x"/>
            </ComboBox>
            <CheckBox x:Name="ChkShowOnlyErrors" Content="Errors Only" Style="{StaticResource DarkCheckBox}"
                      Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"
                      Click="ChkShowOnlyErrors_Click"/>
        </StackPanel>

        <!-- Main Trace List -->
        <ListView x:Name="LvTraceFrames" Grid.Row="2" Style="{StaticResource DarkListView}"
                  SelectionChanged="LvTraceFrames_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="#" Width="50" DisplayMemberBinding="{Binding FrameNumber}"/>
                    <GridViewColumn Header="Time (ms)" Width="90" DisplayMemberBinding="{Binding Timestamp, StringFormat=\{0:F2\}}"/>
                    <GridViewColumn Header="Dir" Width="50">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DirectionDisplay}" FontWeight="Bold" FontSize="16">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Direction}" Value="ReaderToTag">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Direction}" Value="TagToReader">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Data (Hex)" Width="220" DisplayMemberBinding="{Binding RawData}"/>
                    <GridViewColumn Header="CRC" Width="60">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CrcStatus}" FontWeight="Bold" FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CrcValid}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CrcValid}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentRed}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Protocol" Width="110" DisplayMemberBinding="{Binding Protocol}"/>
                    <GridViewColumn Header="Annotation" Width="280" DisplayMemberBinding="{Binding Annotation}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Frame Detail Panel (collapsible) -->
        <Border x:Name="DetailPanel" Grid.Row="3" Background="{StaticResource BgMedium}" CornerRadius="6"
                Padding="16" Margin="0,8,0,0" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Frame #" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,12,4"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DetailFrameNum" Text="-" Foreground="{StaticResource TextPrimary}" FontSize="12" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Raw Hex" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,12,4"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DetailRawHex" Text="-" Foreground="{StaticResource AccentCyan}" FontSize="12" FontFamily="Consolas" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Parity" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,12,4"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DetailParity" Text="-" Foreground="{StaticResource TextDim}" FontSize="12" FontFamily="Consolas" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Bytes" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,12,4"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DetailBytes" Text="-" Foreground="{StaticResource TextPrimary}" FontSize="11" FontFamily="Consolas" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Protocol" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,12,4"/>
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="DetailProtocol" Text="-" Foreground="{StaticResource AccentSecondary}" FontSize="12" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Annotation" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,12,0"/>
                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="DetailAnnotation" Text="-" Foreground="{StaticResource TextPrimary}" FontSize="12"/>
            </Grid>
        </Border>

        <!-- Summary Bar -->
        <Border Grid.Row="4" Background="{StaticResource BgMedium}" CornerRadius="6" Padding="12,8" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TxtFrameCount" Text="Frames: 0" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,16,0"/>
                <TextBlock x:Name="TxtTimeRange" Text="Time: 0.00 - 0.00 ms" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,16,0"/>
                <TextBlock x:Name="TxtProtocolDist" Text="Protocols: -" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
